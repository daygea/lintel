<% var nav = 'accesslog'; var pageTitle = 'Access log'; %>
<%- include("../layouts/head", { nav: nav, pageTitle: typeof pageTitle!=="undefined"?pageTitle:null }) %>
<% var eyebrow = 'ACCESS'; var heading = 'Access log'; var lede = 'Every time the engine holds a door or opens it, a line appears here. This is the receipt — the record of who was admitted to what, and who was not.'; %>
<%- include("../layouts/page-head", { eyebrow: typeof eyebrow!=="undefined"?eyebrow:null, heading: heading, lede: typeof lede!=="undefined"?lede:null }) %>

<div class="section" style="margin-top:22px">
  <table class="table">
    <thead><tr><th>When</th><th>Action</th><th>Policy</th><th>Outcome</th></tr></thead>
    <tbody>
    <% log.forEach(function (e) { %>
      <tr>
        <td class="mono quiet" style="font-size:12.5px"><%= e.createdAt ? new Date(e.createdAt).toLocaleString() : '—' %></td>
        <td><%= e.action ? e.action.replace(/_/g,' ') : '—' %></td>
        <td class="mono"><%= e.policySlug || '—' %></td>
        <td>
          <% if (e.allowed) { %><span class="badge open">opened</span>
          <% } else { %><span class="badge held">held</span><% } %>
        </td>
      </tr>
    <% }); %>
    <% if (!log.length) { %><tr class="empty"><td colspan="4">No access decisions recorded yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include("../layouts/foot") %>
