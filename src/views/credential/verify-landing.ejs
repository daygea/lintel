<% var pageTitle = 'Verify a credential'; %>
<%- include("../layouts/public-head") %>
<div class="pub-card">
  <div class="page-head">
    <div class="eyebrow">VERIFY</div>
    <h1 style="font-size:26px">Verify a credential</h1>
    <p class="lede" style="font-size:14px">Enter the verification code printed on the credential, or scan its QR. This confirms the award only — never marks, standing, or coursework.</p>
  </div>
  <form method="get" onsubmit="if(this.code.value){window.location='/verify/'+encodeURIComponent(this.code.value.trim());}return false;">
    <div class="field">
      <label for="code">Verification code</label>
      <input id="code" name="code" placeholder="e.g. 3f9a…" autofocus>
    </div>
    <button class="btn" type="submit" style="width:100%;justify-content:center">Verify</button>
  </form>
</div>
<%- include("../layouts/public-foot") %>
