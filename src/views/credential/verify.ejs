<% var pageTitle = 'Verify credential'; %>
<%- include("../layouts/public-head") %>
<div class="pub-card">
<% if (!result.valid && result.reason === 'not_found') { %>
  <div class="thr" style="border-left-color:var(--rule-2)">
    <div class="eyebrow mono" style="color:var(--muted);font-size:11px;letter-spacing:.12em">NOT FOUND</div>
    <h1 style="font-family:var(--serif);font-size:24px;margin:6px 0 8px">No matching record</h1>
    <p class="quiet">No credential matches this code. It may have been mistyped.</p>
  </div>
<% } else if (result.revoked) { %>
  <div class="thr is-held">
    <div class="eyebrow mono" style="color:var(--held);font-size:11px;letter-spacing:.12em">REVOKED</div>
    <h1 style="font-family:var(--serif);font-size:24px;margin:6px 0 10px"><%= result.holderName %></h1>
    <p class="quiet">This credential was issued but has since been revoked by the institution.</p>
    <p class="mono" style="font-size:12.5px;color:var(--muted);margin-top:10px"><%= result.serial %></p>
  </div>
<% } else { %>
  <div class="thr is-open">
    <div class="eyebrow mono" style="color:var(--brass);font-size:11px;letter-spacing:.12em">VERIFIED</div>
    <h1 style="font-family:var(--serif);font-size:26px;margin:6px 0 8px"><%= result.holderName %></h1>
    <p style="font-size:16px;margin:0 0 14px"><%= typeof result.award === 'object' ? (result.award.en || Object.values(result.award)[0]) : result.award %></p>
    <div class="mono" style="font-size:12.5px;color:var(--muted);line-height:1.8">
      <%= result.institution %><br>
      Issued <%= new Date(result.issuedAt).toLocaleDateString() %><br>
      <%= result.serial %>
    </div>
  </div>
  <p class="quiet" style="font-size:12.5px;margin-top:20px">This confirms the award only. It does not disclose marks, standing, or coursework — and never will.</p>
<% } %>
</div>
<%- include("../layouts/public-foot") %>
