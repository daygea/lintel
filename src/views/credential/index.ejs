<% var nav = 'credentials'; var pageTitle = 'Credentials'; %>
<%- include("../layouts/head", { nav: nav, pageTitle: typeof pageTitle!=="undefined"?pageTitle:null }) %>
<% var eyebrow = 'RECORDS'; var heading = 'Credentials'; var lede = 'What a graduate can show the world. A credential proves an award and nothing more — never marks, standing, or coursework. Each carries a public code anyone can verify.'; %>
<%- include("../layouts/page-head", { eyebrow: typeof eyebrow!=="undefined"?eyebrow:null, heading: heading, lede: typeof lede!=="undefined"?lede:null }) %>
<div class="section" style="margin-top:22px">
  <h2>Templates</h2>
  <table class="table">
    <thead><tr><th>Template</th><th>Serial format</th></tr></thead>
    <tbody>
    <% templates.forEach(function (t) { %>
      <tr><td><%= pick(t.title, locale) %></td><td class="mono quiet" style="font-size:12px"><%= t.serialFormat %></td></tr>
    <% }); %>
    <% if (!templates.length) { %><tr class="empty"><td colspan="2">No templates yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
<div class="section">
  <h2>Issued</h2>
  <table class="table">
    <thead><tr><th>Holder</th><th>Serial</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% credentials.forEach(function (c) { %>
      <tr>
        <td><%= c.holderName %></td>
        <td class="mono" style="font-size:12.5px"><%= c.serial %></td>
        <td><% if (c.revokedAt) { %><span class="badge held">revoked</span><% } else { %><span class="badge open">valid</span><% } %></td>
        <td style="text-align:right"><% if (!c.revokedAt) { %>
          <form method="post" action="/credentials/<%= c._id %>/revoke" style="display:inline" onsubmit="return confirm('Revoke this credential? This is recorded and cannot be undone.');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="reason" value="revoked by registrar">
            <button class="btn ghost small" type="submit">Revoke</button>
          </form>
        <% } %></td>
      </tr>
    <% }); %>
    <% if (!credentials.length) { %><tr class="empty"><td colspan="4">None issued yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="section" style="margin-top:8px">
  <h2>Issue a credential</h2>
  <% if (typeof error !== "undefined" && error) { %><div class="notice err"><%= error %></div><% } %>
  <% if (templates.length && members.length) { %>
    <form method="post" action="/credentials/issue" style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;max-width:560px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field" style="margin:0"><label for="iss_t">Template</label>
        <select id="iss_t" name="templateId" required><% templates.forEach(function(t){ %><option value="<%= t._id %>"><%= pick(t.title, locale) %></option><% }); %></select>
      </div>
      <div class="field" style="margin:0"><label for="iss_u">Recipient</label>
        <select id="iss_u" name="userId" required><% members.forEach(function(m){ %><% if (m.userId) { %><option value="<%= m.userId._id %>"><%= m.userId.name || m.userId.email %></option><% } %><% }); %></select>
      </div>
      <button class="btn" type="submit">Issue</button>
    </form>
  <% } else { %>
    <p class="quiet" style="font-size:13px">You need at least one template and one active member to issue a credential.</p>
  <% } %>
</div>

<div class="section">
  <h2>New template</h2>
  <p class="hint">A template is the credential's design — its title, the attesting body text, and the serial format. Issuing stamps a serial and names a holder.</p>
  <form method="post" action="/credentials/templates" class="form-narrow" style="max-width:520px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label for="ct_slug">Slug</label><input id="ct_slug" name="slug" placeholder="e.g. diploma-sacred-studies" required></div>
    <% tenant.locales.forEach(function (loc) { %>
      <div class="field"><label for="ct_title_<%= loc %>">Title <span class="quiet mono" style="font-size:11px">(<%= loc %>)</span></label><input id="ct_title_<%= loc %>" name="title_<%= loc %>" <%= loc===tenant.defaultLocale?'required':'' %>></div>
    <% }); %>
    <% tenant.locales.forEach(function (loc) { %>
      <div class="field"><label for="ct_body_<%= loc %>">Body <span class="quiet mono" style="font-size:11px">(<%= loc %>)</span></label><textarea id="ct_body_<%= loc %>" name="body_<%= loc %>" rows="2" placeholder="has completed the programme of study in..."></textarea></div>
    <% }); %>
    <div class="field"><label for="ct_course">Course <span class="quiet">(optional)</span></label>
      <select id="ct_course" name="courseId"><option value="">— none —</option><% (courses||[]).forEach(function(c){ %><option value="<%= c._id %>"><%= pick(c.title, locale) %> · <%= c.code %></option><% }); %></select>
    </div>
    <div class="field"><label for="ct_serial">Serial format</label><input id="ct_serial" name="serialFormat" value="{SLUG}/{YEAR}/{SEQ}" class="mono" style="font-size:13px"><div class="note">{SLUG}, {YEAR}, {SEQ} are filled when issued.</div></div>
    <button class="btn" type="submit">Create template</button>
  </form>
</div>
<%- include("../layouts/foot") %>
