<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Account suspended · Lintel</title>
  <style>
    body{margin:0;background:#F5F4F1;color:#14192B;font-family:-apple-system,"Segoe UI",Roboto,system-ui,sans-serif;line-height:1.6}
    .wrap{max-width:520px;margin:12vh auto;padding:0 20px}
    .card{background:#fff;border:1px solid #E3E0D9;border-radius:10px;padding:28px 30px}
    h1{font-family:Georgia,serif;font-size:22px;margin:0 0 6px}
    .eyebrow{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#B9483E;margin-bottom:10px}
    p{color:#4A4A44;font-size:15px}
    a.btn{display:inline-block;margin-top:14px;background:#14192B;color:#fff;text-decoration:none;padding:9px 16px;border-radius:6px;font-size:14px}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="eyebrow">Account suspended</div>
      <h1>This institution is temporarily unavailable</h1>
      <p>Access is paused while the institution's Lintel plan is renewed. Please contact your administrator — once the account is reactivated, everything returns to normal.</p>
      <a class="btn" href="/logout">Sign out</a>
    </div>
  </div>
</body>
</html>
