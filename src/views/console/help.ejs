<% var nav='help'; var pageTitle='Help'; %>
<%- include("head", { nav: nav, pageTitle: typeof pageTitle!=="undefined"?pageTitle:null }) %>
<div class="page-head">
  <div class="eyebrow">PLATFORM</div>
  <h1>Help & guides</h1>
  <p class="lede">How to run the platform — institutions, oversight, and platform health.</p>
</div>

<%
  var cats = (typeof categories !== 'undefined' && categories) ? categories : [];
  var byCat = {};
  topics.forEach(function (t) { (byCat[t.category] = byCat[t.category] || []).push(t); });
  var sections = cats
    .map(function (c) { return { key: c.key, label: c.label, items: byCat[c.key] || [] }; })
    .filter(function (s) { return s.items.length; });
  var placed = {};
  cats.forEach(function (c) { placed[c.key] = true; });
  var leftovers = topics.filter(function (t) { return !placed[t.category]; });
  if (leftovers.length) sections.push({ key: '_more', label: 'More', items: leftovers });
  var firstOpen = true;
%>

<div class="help-search">
  <label for="help-q" class="sr-only">Search help</label>
  <input id="help-q" type="search" placeholder="Search help — e.g. “break-glass”, “suspend”, “operator”" autocomplete="off" aria-controls="help-sections">
  <p class="help-none" id="help-none" hidden>No guides match that.</p>
</div>

<% if (sections.length > 1) { %>
<nav class="help-toc" aria-label="Help sections">
  <% sections.forEach(function (s) { %><a href="#sec-<%= s.key %>"><%= s.label %></a><% }); %>
</nav>
<% } %>

<div id="help-sections">
<% sections.forEach(function (s) { %>
  <section class="help-sec" id="sec-<%= s.key %>">
    <h2 class="help-sec-h"><%= s.label %></h2>
    <div class="help-list">
      <% s.items.forEach(function (t) { %>
        <details class="help-topic"<%= firstOpen ? ' open' : '' %>>
          <summary>
            <span class="help-t"><%= t.title %></span>
            <span class="help-s"><%= t.summary %></span>
          </summary>
          <% if (t.steps && t.steps.length) { %>
            <p class="help-lbl">How to</p>
            <ol class="help-steps">
              <% t.steps.forEach(function (p) { %><li><%= p %></li><% }); %>
            </ol>
          <% } %>
          <% if (t.points && t.points.length) { %>
            <% if (t.steps && t.steps.length) { %><p class="help-lbl">Good to know</p><% } %>
            <ul class="help-points">
              <% t.points.forEach(function (p) { %><li><%= p %></li><% }); %>
            </ul>
          <% } %>
        </details>
        <% firstOpen = false; %>
      <% }); %>
    </div>
  </section>
<% }); %>
</div>

<style>
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .help-search { max-width:720px; margin-bottom:8px; }
  .help-search input { width:100%; padding:11px 14px; border:1px solid #2a3050; border-radius:8px; background:#161b30; color:#EDECE9; font-size:14.5px; }
  .help-search input:focus { border-color:var(--brass,#C9A567); outline:none; }
  .help-none { font-size:13.5px; color:#9A9CAC; margin:10px 2px 0; }
  .help-toc { max-width:720px; display:flex; flex-wrap:wrap; gap:8px 10px; margin:14px 0 22px; }
  .help-toc a { font-size:12.5px; color:#C9CAD4; border:1px solid #2a3050; border-radius:999px; padding:5px 12px; text-decoration:none; }
  .help-toc a:hover { border-color:var(--brass,#C9A567); color:#fff; }
  .help-sec { max-width:720px; margin-bottom:26px; scroll-margin-top:80px; }
  .help-sec-h { font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:#8E91A3; margin:0 0 10px; font-weight:600; }
  .help-list { max-width:720px; }
  .help-topic { border:1px solid #2a3050; border-radius:8px; margin-bottom:10px; background:#1b2036; }
  .help-topic > summary { cursor:pointer; padding:14px 18px; list-style:none; display:flex; flex-direction:column; gap:2px; position:relative; padding-right:40px; }
  .help-topic > summary::-webkit-details-marker { display:none; }
  .help-topic > summary::after { content:"+"; position:absolute; right:20px; top:14px; color:#8E91A3; font-family:var(--mono,monospace); }
  .help-topic[open] > summary::after { content:"\2013"; }
  .help-t { font-weight:600; color:#EDECE9; }
  .help-s { font-size:13px; color:#9A9CAC; }
  .help-lbl { margin:12px 20px 2px; font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:#8E91A3; font-weight:600; }
  .help-topic ol, .help-topic ul { margin:2px 0 0; padding:2px 20px 16px 38px; }
  .help-topic li { margin:6px 0; color:#C9CAD4; line-height:1.55; }
  .help-steps li { padding-left:4px; }
  .help-topic.is-hidden { display:none; }
</style>

<script>
  (function () {
    var q = document.getElementById('help-q');
    if (!q) return;
    var topics = Array.prototype.slice.call(document.querySelectorAll('.help-topic'));
    var sections = Array.prototype.slice.call(document.querySelectorAll('.help-sec'));
    var none = document.getElementById('help-none');
    q.addEventListener('input', function () {
      var term = q.value.trim().toLowerCase();
      var anyShown = false;
      topics.forEach(function (el) {
        var hit = !term || el.textContent.toLowerCase().indexOf(term) !== -1;
        el.classList.toggle('is-hidden', !hit);
        if (hit) anyShown = true;
        if (term && hit) el.setAttribute('open', '');
      });
      sections.forEach(function (sec) {
        var visible = sec.querySelectorAll('.help-topic:not(.is-hidden)').length;
        sec.style.display = visible ? '' : 'none';
      });
      if (none) none.hidden = anyShown;
    });
  })();
</script>
<%- include("foot") %>
