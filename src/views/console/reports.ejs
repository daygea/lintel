<% var nav='reports'; var pageTitle='Reports'; %>
<%- include("head", { nav: nav, pageTitle: pageTitle }) %>
<div class="page-head">
  <div class="eyebrow">PLATFORM</div>
  <h1>Abuse reports</h1>
  <p class="lede">Reports awaiting review. Investigate through metadata and the audit trail; reaching actual content requires an explicit, notified break-glass grant.</p>
</div>
<ul class="rows">
  <% reports.forEach(function(r){ %>
    <li>
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px">
        <div>
          <span class="badge <%= r.category==='illegal_content'?'held':'flat' %>"><%= r.category ? r.category.replace(/_/g,' ') : 'other' %></span>
          <span class="quiet" style="font-size:13px;margin-left:8px"><%= r.subjectType %><%= r.subjectRef ? ' · '+r.subjectRef : '' %></span>
          <% if (r.detail) { %><div class="meta" style="margin-top:6px"><%= r.detail %></div><% } %>
          <div class="meta mono" style="font-size:12px;margin-top:4px"><%= new Date(r.createdAt).toLocaleString() %></div>
        </div>
        <a class="btn ghost small" href="/console/reports/<%= r._id %>">Review</a>
      </div>
    </li>
  <% }); %>
  <% if(!reports.length){ %><li class="quiet">No open reports.</li><% } %>
</ul>
<%- include("foot") %>
