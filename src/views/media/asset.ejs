<% var nav = 'media'; var pageTitle = asset.filename; %>
<%- include("../layouts/head", { nav: nav, pageTitle: typeof pageTitle!=="undefined"?pageTitle:null }) %>
<div style="margin-bottom:8px"><a href="/media" class="quiet mono" style="font-size:12px">← back to media</a></div>
<% var eyebrow = 'MEDIA'; var heading = asset.filename; var lede = null; %>
<%- include("../layouts/page-head", { eyebrow: typeof eyebrow!=="undefined"?eyebrow:null, heading: heading, lede: typeof lede!=="undefined"?lede:null }) %>
<div style="margin:-14px 0 8px">
  <span class="badge <%= asset.status==='ready'?'ok':(asset.status==='error'?'held':'flat') %>"><%= asset.status %></span>
  <span class="quiet" style="margin-left:8px"><%= asset.kind %></span>
  <% if (asset.bytes) { %><span class="quiet mono" style="margin-left:10px;font-size:12px"><%= (asset.bytes/1024/1024).toFixed(1) %> MB</span><% } %>
</div>
<% if (asset.error) { %><div class="notice err"><%= asset.error %></div><% } %>
<% if (typeof error !== "undefined" && error) { %><div class="notice err" role="alert"><%= error %></div><% } %>

<% var streamable = (asset.kind === 'audio' || asset.kind === 'video'); %>

<% if (streamable) { %>
  <div class="section">
    <h2>Renditions</h2>
    <p class="hint">Audio and video are transcoded into a ladder of bitrates so a learner on a slow connection still gets the lesson. These are produced by the transcode worker after upload.</p>
    <table class="table">
      <thead><tr><th>Rung</th><th>Bitrate</th></tr></thead>
      <tbody>
      <% (asset.derivatives||[]).forEach(function (d) { %>
        <tr><td class="mono"><%= d.rung %></td><td class="mono quiet"><%= d.bitrateKbps ? d.bitrateKbps + ' kbps' : '—' %></td></tr>
      <% }); %>
      <% if (!(asset.derivatives||[]).length) { %>
        <% if (asset.status === 'processing') { %>
          <tr class="empty"><td colspan="2">Transcoding now — renditions will appear here when the worker finishes. Refresh in a moment.</td></tr>
        <% } else if (asset.status === 'error') { %>
          <tr class="empty"><td colspan="2">Transcode failed. Check the worker logs; re-uploading will retry.</td></tr>
        <% } else { %>
          <tr class="empty"><td colspan="2">No renditions. If this asset is stuck without any, the transcode worker may not be running (it is a separate process — see <span class="mono">npm run worker</span>).</td></tr>
        <% } %>
      <% } %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="section">
    <h2>File</h2>
    <% if (asset.status === 'ready') { %>
      <div class="thr is-open" style="padding:8px 0 8px 16px">
        <span class="badge open">ready</span>
        <span class="quiet" style="font-size:13px;margin-left:8px">This <%= asset.kind %> needs no transcoding — it is stored as uploaded and ready to attach to a lesson.</span>
      </div>
    <% } else { %>
      <div class="panel quiet">Status: <%= asset.status %>.</div>
    <% } %>
  </div>
<% } %>
<div class="section">
  <h2>Manage</h2>
  <form method="post" action="/media/<%= asset._id %>/rename" style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;max-width:520px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="flex:1;min-width:220px">
      <label for="fname">File name</label>
      <input id="fname" name="filename" type="text" value="<%= asset.filename %>" required>
    </div>
    <button class="btn" type="submit">Rename</button>
  </form>

  <div style="margin-top:18px;padding:12px 16px;border:1px solid var(--rule);border-radius:6px;max-width:520px">
    <strong>Delete this file</strong>
    <p class="quiet" style="font-size:13px;margin:4px 0 10px">Removes the file and all its renditions from storage — this can't be undone. A file that's attached to a lesson can't be deleted until it's removed from that lesson.</p>
    <form method="post" action="/media/<%= asset._id %>/delete" onsubmit="return confirm('Delete this file and all its renditions? This cannot be undone.')">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn ghost" type="submit">Delete file</button>
    </form>
  </div>
</div>
<%- include("../layouts/foot") %>
