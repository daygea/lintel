<% var nav = 'media'; var pageTitle = 'Media'; %>
<%- include("../layouts/head", { nav: nav, pageTitle: typeof pageTitle!=="undefined"?pageTitle:null }) %>
<% var eyebrow = 'TEACHING'; var heading = 'Media'; var lede = 'Uploaded recordings and documents. Restricted material is streamed and watermarked, never downloadable — the delivery follows the content policy.'; %>
<%- include("../layouts/page-head", { eyebrow: typeof eyebrow!=="undefined"?eyebrow:null, heading: heading, lede: typeof lede!=="undefined"?lede:null }) %>
<div style="margin:-8px 0 20px"><a class="btn" href="/media/upload">Upload media</a></div>
<div class="section" style="margin-top:22px">
  <table class="table">
    <thead><tr><th>File</th><th>Kind</th><th>Status</th></tr></thead>
    <tbody>
    <% assets.forEach(function (a) { %>
      <tr>
        <td><a href="/media/<%= a._id %>" class="mono" style="font-size:13px"><%= a.filename %></a></td>
        <td class="quiet"><%= a.kind %></td>
        <td>
          <% if (a.status === 'ready') { %><span class="badge ok">ready</span>
          <% } else if (a.status === 'error') { %><span class="badge held">error</span>
          <% } else { %><span class="badge flat"><%= a.status %></span><% } %>
        </td>
      </tr>
    <% }); %>
    <% if (!assets.length) { %><tr class="empty"><td colspan="3">No media uploaded yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include("../layouts/foot") %>
