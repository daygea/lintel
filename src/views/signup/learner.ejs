<%
  var pageTitle = 'Create your account';
  var panelTitle = 'Join ' + ((typeof tenant !== 'undefined' && tenant && tenant.name) ? tenant.name : 'the institution');
  var panelLede = 'Create a learner account to apply. A registrar admits you — until then you can see the institution’s open material.';
%>
<%- include("../layouts/auth-head", { pageTitle: pageTitle, panelTitle: panelTitle, panelLede: panelLede }) %>

<div class="auth-head">
  <h2>Create your account</h2>
  <p class="auth-sub">Register as a learner. We’ll email you a link to set your password.</p>
</div>

<% if (typeof error !== 'undefined' && error) { %><div class="notice err" role="alert" style="margin-bottom:16px"><%= error %></div><% } %>

<form method="post" action="/join" aria-label="Create a learner account">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field">
    <label for="name">Your name</label>
    <input id="name" name="name" value="<%= values.name || '' %>" required autofocus autocomplete="name">
  </div>
  <div class="field">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="<%= values.email || '' %>" required autocomplete="email">
    <div class="note">We’ll email you a link to set your password.</div>
  </div>
  <button class="btn brass" type="submit">Create account</button>
</form>
<p class="auth-alt">Already have an account? <a href="/login">Sign in</a></p>

<%- include("../layouts/auth-foot") %>
