<% var pageTitle = 'Set your password'; %>
<%- include("../layouts/public-head") %>
<div class="pub-card">
  <div class="page-head">
    <div class="eyebrow">WELCOME</div>
    <h1 style="font-size:26px">Set your password</h1>
    <p class="lede" style="font-size:14px">Choose a password to finish setting up your account.</p>
  </div>
  <% if (error) { %><div class="notice err"><%= error %></div><% } %>
  <form method="post" action="/onboard/<%= token %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="password">New password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required autofocus>
      <div class="note">At least 8 characters.</div>
    </div>
    <button class="btn" type="submit" style="width:100%;justify-content:center">Set password and sign in</button>
  </form>
</div>
<%- include("../layouts/public-foot") %>
