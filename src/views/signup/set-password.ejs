<%
  var pageTitle = 'Set your password';
  var panelTitle = 'Welcome to Lintel';
  var panelLede = 'Choose a password to finish setting up your account and sign in.';
%>
<%- include("../layouts/auth-head", { pageTitle: pageTitle, panelTitle: panelTitle, panelLede: panelLede }) %>

<div class="auth-head">
  <h2>Set your password</h2>
  <p class="auth-sub">Choose a password to finish setting up your account.</p>
</div>

<% if (typeof error !== 'undefined' && error) { %><div class="notice err" role="alert" style="margin-bottom:16px"><%= error %></div><% } %>

<form method="post" action="/onboard/<%= token %>" aria-label="Set your password">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field">
    <label for="password">New password</label>
    <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" required autofocus aria-describedby="pw-note">
    <div class="note" id="pw-note">At least 10 characters.</div>
  </div>
  <button class="btn brass" type="submit">Set password &amp; sign in</button>
</form>

<%- include("../layouts/auth-foot") %>
