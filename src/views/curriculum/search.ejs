<%- include("../layouts/head") %>
<h1>Search</h1>
<p><a href="/courses">← All courses</a></p>

<form method="get" action="/courses/search">
  <input name="q" value="<%= q %>" placeholder="oriki, ayanmo…">
  <button type="submit">Search</button>
</form>

<% if (q) { %>
  <p style="color:#6E6B63;font-size:14px;margin-top:20px">
    <%= results.courses.length + results.lessons.length + results.programs.length %> result(s) for “<%= q %>”
  </p>

  <% if (results.courses.length) { %>
    <h2 style="font-size:16px;margin-top:22px">Courses</h2>
    <table><tbody>
    <% results.courses.forEach(function (c) { %>
      <tr><td><a href="/courses/<%= c._id %>"><%= pick(c.title, locale) %></a></td><td style="color:#6E6B63"><%= c.code %></td></tr>
    <% }); %>
    </tbody></table>
  <% } %>

  <% if (results.lessons.length) { %>
    <h2 style="font-size:16px;margin-top:22px">Lessons</h2>
    <table><tbody>
    <% results.lessons.forEach(function (l) { %>
      <tr><td><a href="/courses/<%= l.courseId %>"><%= pick(l.title, locale) %></a></td></tr>
    <% }); %>
    </tbody></table>
  <% } %>
<% } %>
<%- include("../layouts/foot") %>
