<% var nav = 'courses'; var pageTitle = 'Search'; %>
<%- include("../layouts/head", { nav: nav, pageTitle: typeof pageTitle!=="undefined"?pageTitle:null }) %>
<% var eyebrow = 'TEACHING'; var heading = 'Search results'; var lede = 'Diacritics optional — oriki finds Oríkì.'; %>
<%- include("../layouts/page-head", { eyebrow: typeof eyebrow!=="undefined"?eyebrow:null, heading: heading, lede: typeof lede!=="undefined"?lede:null }) %>
<div class="section" style="margin-top:22px">
  <h2>Courses <span class="quiet mono" style="font-size:13px">(<%= results.courses.length %>)</span></h2>
  <ul class="rows">
    <% results.courses.forEach(function (c) { %>
      <li><a href="/courses/<%= c._id %>" class="mono"><%= c.code %></a> <span class="title"><%= pick(c.title, locale) %></span></li>
    <% }); %>
    <% if (!results.courses.length) { %><li class="quiet">No courses matched.</li><% } %>
  </ul>
</div>
<%- include("../layouts/foot") %>
