<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title><%= (typeof pageTitle !== 'undefined' ? pageTitle + ' · ' : '') + (typeof tenant !== 'undefined' && tenant ? tenant.name : 'Lintel') %></title>
  <link rel="stylesheet" href="/css/lintel.css">
</head>
<body>
<%
  /* Navigation model, grouped the way an administrator thinks.
     Each item is [key, href, label]; `nav` (set by the view) marks the active one. */
  var active = typeof nav !== 'undefined' ? nav : '';
  var groups = [
    ['Teaching', [
      ['courses',   '/courses',    'Courses'],
      ['media',     '/media',      'Media'],
      ['cohorts',   '/cohorts',    'Cohorts'],
    ]],
    ['People', [
      ['members',   '/',           'Members'],
      ['register',  '/register',   'Attestations'],
    ]],
    ['Access', [
      ['policies',  '/policies',   'Eligibility'],
      ['accesslog', '/access-log', 'Access log'],
    ]],
    ['Assessment', [
      ['assessments','/assessments','Assessments'],
      ['gradebook', '/gradebook',  'Gradebook'],
    ]],
    ['Records', [
      ['fees',      '/fees',        'Fees'],
      ['credentials','/credentials','Credentials'],
      ['directory', '/directory-listing', 'Public listing'],
    ]],
  ];
%>
<div class="app">
  <aside class="rail">
    <div class="brand"><span class="mark"></span> Lintel</div>
    <div class="inst"><%= tenant.name %></div>
    <nav>
      <% groups.forEach(function (g) { %>
        <div class="group"><%= g[0] %></div>
        <% g[1].forEach(function (item) { %>
          <a href="<%= item[1] %>" class="<%= active === item[0] ? 'active' : '' %>"><%= item[2] %></a>
        <% }); %>
      <% }); %>
    </nav>
    <div class="foot">
      <a href="/api/v1/export" style="color:#8A8DA0">Export data</a>
    </div>
  </aside>
  <div class="content">
    <div class="topbar">
      <div class="crumbs">
        <a href="/"><%= tenant.name %></a>
        <% if (typeof pageTitle !== 'undefined' && pageTitle) { %><span class="sep">/</span><%= pageTitle %><% } %>
      </div>
      <div class="who">
        <% if (typeof user !== "undefined" && user) { %><%= user.name %><% } %>
        <a href="/report" style="margin-right:12px">Report</a><a href="/security" style="margin-right:12px">Security</a><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Sign out</button></form>
      </div>
    </div>
    <main class="main">
