<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Lintel' %></title>
  <link rel="stylesheet" href="/css/lintel.css">
  <style>
    .pub { min-height: 100vh; display: grid; grid-template-rows: auto 1fr auto; }
    .pub-bar { padding: 20px 32px; border-bottom: 1px solid var(--rule); }
    .pub-bar .brand { display: inline-flex; align-items: baseline; gap: 9px; font-family: var(--serif); font-size: 20px; font-weight: 600; color: var(--ink); text-decoration: none; }
    .pub-bar .brand:hover { text-decoration: none; }
    .pub-bar .mark { display:inline-block; width:14px; height:14px; position:relative; }
    .pub-bar .mark::before { content:""; position:absolute; left:2px; top:0; width:10px; height:3px; background:var(--brass); }
    .pub-bar .mark::after  { content:""; position:absolute; left:4px; top:3px; width:3px; height:11px; background:var(--ink-soft); }
    .pub-main { display: grid; place-items: center; padding: 48px 24px; }
    .pub-card { width: 100%; max-width: 420px; }
    .pub-wide { width: 100%; max-width: 640px; }
    .pub-foot { padding: 20px 32px; border-top: 1px solid var(--rule); font-size: 12.5px; color: var(--muted); font-family: var(--mono); }
  </style>
</head>
<body>
<div class="pub">
  <header class="pub-bar"><a class="brand" href="/" aria-label="Lintel home"><span class="mark"></span> Lintel</a></header>
  <main class="pub-main">
