<% var pageTitle = 'Awaiting admission'; %>
<%- include("../layouts/public-head") %>
<div class="pub-card">
  <div class="page-head">
    <div class="eyebrow"><%= typeof tenant !== 'undefined' && tenant ? tenant.name.toUpperCase() : 'LINTEL' %></div>
    <h1 style="font-size:26px">Registration received</h1>
    <p class="lede" style="font-size:14px">Your place is being reviewed.</p>
  </div>
  <div class="thr is-held" style="padding:12px 0 12px 16px;margin-bottom:16px">
    <span class="badge held">held</span>
    <span class="quiet" style="font-size:13px;margin-left:8px">Awaiting admission by the institution</span>
  </div>
  <p style="font-size:14px;line-height:1.6">
    Thank you for registering<% if (typeof tenant !== 'undefined' && tenant) { %> at <strong><%= tenant.name %></strong><% } %>.
    A registrar reviews each request before a place is opened. You'll be able to sign in
    and see your teaching once you've been admitted — there's nothing more you need to do now.
  </p>
  <div style="margin-top:20px">
    <form method="post" action="/logout" style="display:inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn ghost small" type="submit">Sign out</button>
    </form>
  </div>
</div>
<%- include("../layouts/public-foot") %>
