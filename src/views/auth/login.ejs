<%
  var isMfa = typeof mfaRequired !== 'undefined' && mfaRequired;
  var pageTitle = isMfa ? 'Two-factor' : 'Sign in';
  var panelTitle = 'Welcome back';
  var panelLede = 'Sign in to continue to your institution. Your access reflects the standing you hold here.';
%>
<%- include("../layouts/auth-head", { pageTitle: pageTitle, panelTitle: panelTitle, panelLede: panelLede }) %>

<% if (typeof error !== 'undefined' && error) { %><div class="notice err" role="alert" style="margin-bottom:16px"><%= error %></div><% } %>

<% if (isMfa) { %>
  <div class="auth-head">
    <h2>Two-factor verification</h2>
    <p class="auth-sub">Enter the 6-digit code from your authenticator app to finish signing in.</p>
  </div>
  <form method="post" action="/login" aria-label="Two-factor verification">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="totp">Authentication code</label>
      <input id="totp" name="totp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*"
             placeholder="123456" required autofocus aria-describedby="totp-note">
      <div class="note" id="totp-note">From your authenticator app.</div>
    </div>
    <button class="btn brass" type="submit">Verify &amp; sign in</button>
  </form>
  <p class="auth-mini"><a href="/login">← Start over</a></p>
<% } else { %>
  <div class="auth-head">
    <h2>Sign in</h2>
    <p class="auth-sub">Enter your credentials to continue<% if (typeof tenant !== 'undefined' && tenant && tenant.name) { %> to <%= tenant.name %><% } %>.</p>
  </div>
  <form method="post" action="/login" aria-label="Sign in">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="username" required autofocus
             value="<%= typeof email !== 'undefined' ? email : '' %>">
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
    </div>
    <button class="btn brass" type="submit">Sign in</button>
  </form>
  <p class="auth-alt">New learner here? <a href="/join">Create an account</a></p>
<% } %>

<%- include("../layouts/auth-foot") %>
