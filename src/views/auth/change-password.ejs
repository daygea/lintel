<%
  var pageTitle = 'Set a new password';
  var panelTitle = forced ? 'Set a new password' : 'Change your password';
  var panelLede = forced
    ? 'Your account was created with a temporary password. Choose a permanent one to continue.'
    : 'Choose a new password for your account.';
%>
<%- include("../layouts/auth-head", { pageTitle: pageTitle, panelTitle: panelTitle, panelLede: panelLede }) %>

<div class="auth-head">
  <h2><%= forced ? 'Set a new password' : 'Change your password' %></h2>
  <p class="auth-sub"><%= forced ? 'This is required before you can continue.' : 'Enter your current password, then a new one.' %></p>
</div>

<% if (typeof error !== 'undefined' && error) { %><div class="notice err" role="alert" style="margin-bottom:16px"><%= error %></div><% } %>

<form method="post" action="/account/password" aria-label="Change password">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field">
    <label for="currentPassword"><%= forced ? 'Temporary password' : 'Current password' %></label>
    <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required autofocus>
  </div>
  <div class="field">
    <label for="newPassword">New password</label>
    <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="10" required aria-describedby="pw-note">
    <div class="note" id="pw-note">At least 10 characters.</div>
  </div>
  <button class="btn brass" type="submit">Save new password</button>
</form>
<% if (!forced) { %><p class="auth-mini"><a href="/">← Back</a></p><% } %>

<%- include("../layouts/auth-foot") %>
