<% var nav = 'assessments'; var pageTitle = pick(assessment.title, locale); %>
<%- include("../layouts/head", { nav: nav, pageTitle: typeof pageTitle!=="undefined"?pageTitle:null }) %>
<% var eyebrow = 'ASSESSMENT'; var heading = pick(assessment.title, locale); var lede = null; %>
<%- include("../layouts/page-head", { eyebrow: typeof eyebrow!=="undefined"?eyebrow:null, heading: heading, lede: typeof lede!=="undefined"?lede:null }) %>
<div style="margin:-14px 0 8px" class="quiet">
  <%= assessment.type %><% if (assessment.requiresModeration) { %> · moderated by <%= assessment.moderatorRole %><% } %>
</div>
<div class="section">
  <h2>Submissions</h2>
  <table class="table">
    <thead><tr><th>Learner</th><th>Attempt</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% submissions.forEach(function (s) { %>
      <tr>
        <td><%= s.userId ? s.userId.name : '—' %></td>
        <td class="mono"><%= s.attemptNo %></td>
        <td><span class="badge <%= s.status==='graded'?'ok':'flat' %>"><%= s.status %></span></td>
        <td><a href="/submissions/<%= s._id %>/grade" class="btn ghost small">Grade</a></td>
      </tr>
    <% }); %>
    <% if (!submissions.length) { %><tr class="empty"><td colspan="4">Nothing submitted yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include("../layouts/foot") %>
