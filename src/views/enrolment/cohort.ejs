<% var nav = 'cohorts'; var pageTitle = 'Cohort'; %>
<%- include("../layouts/head", { nav: nav, pageTitle: typeof pageTitle!=="undefined"?pageTitle:null }) %>
<% var eyebrow = 'COHORT'; var heading = 'Roster'; var lede = 'Applications awaiting a decision, and the enrolled roster. Admission is a person\'s act — it creates a place; declining does not.'; %>
<%- include("../layouts/page-head", { eyebrow: typeof eyebrow!=="undefined"?eyebrow:null, heading: heading, lede: typeof lede!=="undefined"?lede:null }) %>
<div class="section" style="margin-top:22px">
  <h2>Applications</h2>
  <table class="table">
    <thead><tr><th>Applicant</th><th>Status</th></tr></thead>
    <tbody>
    <% (applications||[]).forEach(function (a) { %>
      <tr><td><%= a.userId && a.userId.name ? a.userId.name : '—' %></td><td><span class="badge flat"><%= a.status %></span></td></tr>
    <% }); %>
    <% if (!(applications||[]).length) { %><tr class="empty"><td colspan="2">No applications.</td></tr><% } %>
    </tbody>
  </table>
</div>
<div class="section">
  <h2>Enrolled <span class="quiet mono" style="font-size:13px">(<%= (enrollments||[]).length %>)</span></h2>
  <table class="table">
    <thead><tr><th>Learner</th><th>Status</th><th>Fees</th></tr></thead>
    <tbody>
    <% (enrollments||[]).forEach(function (e) { %>
      <tr>
        <td><%= e.userId && e.userId.name ? e.userId.name : '—' %></td>
        <td><span class="badge <%= e.status==='active'?'ok':'flat' %>"><%= e.status %></span></td>
        <td>
          <% if (e.paymentState==='full'||e.paymentState==='waived') { %><span class="badge open"><%= e.paymentState %></span>
          <% } else { %><span class="badge held"><%= e.paymentState || 'unpaid' %></span><% } %>
          <% var inv = invoiceByEnrollment ? invoiceByEnrollment[String(e._id)] : null; %>
          <% if (inv) { %>
            <a class="btn ghost small" href="/invoices/<%= inv._id %>" style="margin-left:8px">Invoice</a>
          <% } else if ((schedules||[]).length) { %>
            <form method="post" action="/invoices" style="display:inline-flex;gap:6px;align-items:center;margin-left:8px">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="enrollmentId" value="<%= e._id %>">
              <select name="feeScheduleId" required style="font-size:12px">
                <% schedules.forEach(function (s) { %><option value="<%= s._id %>"><%= pick(s.label, locale) %></option><% }); %>
              </select>
              <button class="btn small" type="submit">Raise invoice</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }); %>
    <% if (!(enrollments||[]).length) { %><tr class="empty"><td colspan="3">No one enrolled yet.</td></tr><% } %>
    </tbody>
  </table>

  <% if ((enrollable||[]).length) { %>
    <form method="post" action="/cohorts/<%= cohortId %>/enrol" style="margin-top:14px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="enrol-user" class="quiet" style="font-size:13px">Enrol a member</label>
      <select id="enrol-user" name="userId" required>
        <% enrollable.forEach(function (m) { %>
          <option value="<%= m.userId._id %>"><%= m.userId.name %><%= m.userId.email ? ' — ' + m.userId.email : '' %></option>
        <% }); %>
      </select>
      <button class="btn small" type="submit">Enrol</button>
    </form>
    <p class="quiet" style="font-size:12px;margin-top:6px">Places them directly in this cohort — their courses open immediately (subject to eligibility).</p>
  <% } else { %>
    <p class="quiet" style="font-size:13px;margin-top:12px">No admitted learners left to enrol. Admit members on the dashboard first.</p>
  <% } %>
</div>

<div class="section">
  <h2>Status</h2>
  <% if (cohort) { %>
    <div style="margin-bottom:10px"><span class="badge <%= cohort.status==='open'?'ok':'flat' %>"><%= cohort.status %></span></div>
    <% if (cohort.status === 'draft' || cohort.status === 'closed') { %>
      <form method="post" action="/cohorts/<%= cohortId %>/open" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small" type="submit">Open for applications</button></form>
    <% } %>
    <% if (cohort.status === 'open' || cohort.status === 'running') { %>
      <form method="post" action="/cohorts/<%= cohortId %>/close" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost small" type="submit">Close cohort</button></form>
    <% } %>
    <form method="post" action="/cohorts/<%= cohortId %>/delete" style="display:inline;margin-left:6px" onsubmit="return confirm('Delete this cohort? This cannot be undone. (A cohort with enrolled learners cannot be deleted.)')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost small" type="submit">Delete cohort</button></form>
    <% if (typeof error !== "undefined" && error) { %><div class="notice err" role="alert" style="margin-top:8px"><%= error %></div><% } %>
  <% } %>
</div>

<div class="section">
  <h2>Sessions</h2>
  <% (sessions||[]).forEach(function (sn) { %>
    <div class="panel" style="margin-bottom:10px">
      <div style="font-weight:500"><%= pick(sn.title, locale) %></div>
      <% if (sn.startsAt) { %><div class="quiet mono" style="font-size:12px"><%= new Date(sn.startsAt).toLocaleString() %></div><% } %>
      <% if (enrollments && enrollments.length) { %>
        <details style="margin-top:8px">
          <summary class="quiet" style="cursor:pointer;font-size:13px">Mark attendance</summary>
          <% enrollments.forEach(function (en) { %>
            <form method="post" action="/cohorts/<%= cohortId %>/attendance" style="display:flex;gap:8px;align-items:center;margin-top:6px">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="sessionId" value="<%= sn._id %>">
              <input type="hidden" name="userId" value="<%= en.userId %>">
              <span style="min-width:160px;font-size:13px"><%= en.userName || en.userId %></span>
              <select name="state"><option value="present">present</option><option value="absent">absent</option><option value="excused">excused</option></select>
              <button class="btn ghost small" type="submit">Save</button>
            </form>
          <% }); %>
        </details>
      <% } %>
    </div>
  <% }); %>
  <% if (!(sessions||[]).length) { %><div class="quiet" style="font-size:13px;margin-bottom:10px">No sessions yet.</div><% } %>

  <details style="margin-top:8px">
    <summary style="cursor:pointer;font-weight:500">+ Add session</summary>
    <form method="post" action="/cohorts/<%= cohortId %>/sessions" style="margin-top:12px;max-width:440px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% tenant.locales.forEach(function (loc) { %>
        <div class="field"><label for="st_<%= loc %>">Session title <span class="quiet mono" style="font-size:11px">(<%= loc %>)</span></label><input id="st_<%= loc %>" name="title_<%= loc %>" <%= loc===tenant.defaultLocale?'required':'' %>></div>
      <% }); %>
      <div class="field"><label for="startsAt">Starts at</label><input id="startsAt" name="startsAt" type="datetime-local" required></div>
      <button class="btn small" type="submit">Add session</button>
    </form>
  </details>
</div>
<%- include("../layouts/foot") %>
